# about: document summarizer with a declassified title in system
# expect: ok
# category: realistic
input title
input document
var style = "three bullet points, plain English"
system {
    """
    You summarise documents in {style}.
    """
    "Document title:"
    insert(declassify(title, "titles are short and shown to the model as metadata"))
}
instruction { insert(document) }
