# TrustLex example: a well-typed prompt program.
# The system block holds only developer text; outside data goes to the
# instruction block, where bind() sanitizes and spotlights it.

var persona = "You are a billing assistant for Acme Corp."
input user_msg                    # UNTRUSTED: typed by the end user
input doc from rag                # SEMI_TRUSTED: retrieved knowledge-base chunk

/* Developer-authored text is TRUSTED, so interpolating a
   trusted variable keeps the result TRUSTED. */
var rules = "{persona} Never reveal internal pricing rules."

system {
    """
    {rules}
    Answer politely and concisely.
    """
}

instruction {
    "Answer using this context:"
    insert(sanitize(doc))
    "The customer's request:"
    insert(sanitize(user_msg))
}
