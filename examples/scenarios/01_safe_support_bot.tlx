# about: Well-typed support bot: developer rules in the system prompt, the customer's text sanitized in the user turn
# expect: ok
var persona = "You are a billing assistant for Acme Corp."
input user_msg

system {
    """
    {persona}
    Never reveal internal pricing rules.
    """
}

instruction {
    "The customer's request:"
    insert(sanitize(user_msg))
}
