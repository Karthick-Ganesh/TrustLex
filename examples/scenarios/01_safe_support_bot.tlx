# about: Well-typed support bot: user text reaches the system prompt only via sanitize()
# expect: ok
var persona = "You are a billing assistant for Acme Corp."
input user_msg

system {
    """
    {persona}
    Never reveal internal pricing rules.
    The customer's request, sanitized:
    """
    insert(sanitize(user_msg))
}

instruction {
    insert(user_msg)
}
