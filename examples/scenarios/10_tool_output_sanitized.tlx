# about: Tool output enters the system prompt only through an explicit declassify() with a reason (compiles, with warning TL-W004)
# expect: ok
input question
input weather from tool

system {
    "You are a travel assistant. Current weather report:"
    insert(declassify(weather, "the weather service is operated by us and returns short forecasts"))
}

instruction {
    insert(question)
}
